{
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/admin/tournament/draw", "destination": "/api/admin/tournament.js" },
    { "source": "/api/admin/tournament/advance", "destination": "/api/admin/tournament.js" },
    { "source": "/api/admin/headline", "destination": "/api/admin/headline.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
